<!doctype html>
<html lang="de">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>{{ 'app.mail.delivery.title'|trans }}</title></head>
<body style="margin:0; padding:0; background-color:{{ EMAIL_THEME.pageBackground }}; font-family:Arial,Helvetica,sans-serif; color:{{ EMAIL_THEME.text }};"><table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%; background-color:{{ EMAIL_THEME.pageBackground }};"><tr><td align="center" style="padding:24px 12px;"><table role="presentation" width="600" cellspacing="0" cellpadding="0" border="0" style="width:100%; max-width:600px; background-color:{{ EMAIL_THEME.surface }}; border:1px solid {{ EMAIL_THEME.outline }}; border-radius:20px;">
    <tr><td style="padding:32px 32px 18px 32px; text-align:center; background-color:{{ EMAIL_THEME.primaryContainer }};"><table role="presentation" cellspacing="0" cellpadding="0" border="0" align="center" style="margin:0 auto 22px auto;"><tr><td align="center"><img src="{{ LOGO_CID }}" width="210" alt="Gärngschee" style="display:block; width:210px; max-width:100%; height:auto;"></td></tr></table><h1 style="margin:0; font-size:28px; line-height:1.2; font-weight:700; color:{{ EMAIL_THEME.text }};">{{ 'app.mail.delivery.title'|trans }}</h1></td></tr>
    <tr><td style="padding:0 32px 8px 32px;"><p style="margin:0 0 14px 0; font-size:18px; line-height:1.5; color:{{ EMAIL_THEME.text }};">{{ 'app.mail.delivery.greeting'|trans }}</p><p style="margin:0; font-size:17px; line-height:1.55; color:{{ EMAIL_THEME.mutedText }};">{{ 'app.mail.delivery.introduction'|trans }}</p></td></tr>
    <tr><td style="padding:20px 32px 8px 32px; font-size:17px; line-height:1.5; color:{{ EMAIL_THEME.text }};"><p style="margin:0 0 12px 0; font-weight:700;">{{ 'app.mail.delivery.pickupInformationTitle'|trans }}</p><p style="margin:4px 0;"><span aria-hidden="true">📅</span> <strong>{{ 'app.mail.delivery.pickupDateLabel'|trans }}:</strong> {{ 'app.mail.delivery.pickupDate'|trans }}</p><p style="margin:4px 0;"><span aria-hidden="true">⏰</span> <strong>{{ 'app.mail.delivery.pickupTimeLabel'|trans }}:</strong> {{ 'app.mail.delivery.pickupTime'|trans }}</p><p style="margin:4px 0;"><span aria-hidden="true">📍</span> <strong>{{ 'app.mail.delivery.pickupLocationLabel'|trans }}:</strong> {{ 'app.mail.delivery.pickupLocation'|trans }}</p></td></tr>
    <tr><td style="padding:20px 32px 8px 32px; font-size:17px; line-height:1.55; color:{{ EMAIL_THEME.text }};"><p style="margin:0 0 12px 0; font-weight:700;">{{ 'app.mail.delivery.pickupImportantTitle'|trans }}</p><p style="margin:0; color:{{ EMAIL_THEME.mutedText }};">{{ 'app.mail.delivery.pickupQrInstruction'|trans }}</p></td></tr>
    <tr><td style="padding:18px 32px 8px 32px; text-align:center;"><img src="{{ QR_DATA_URI|raw }}" width="300" height="300" alt="{{ 'app.mail.delivery.qrAlt'|trans }}" style="display:block; width:300px; max-width:100%; height:auto; margin:0 auto;"></td></tr>
    <tr><td style="padding:8px 32px; font-size:16px; line-height:1.55; color:{{ EMAIL_THEME.mutedText }};">{{ 'app.mail.delivery.pickupProxy'|trans }}</td></tr>
    <tr><td style="padding:8px 32px 18px 32px; font-size:16px; line-height:1.55; color:{{ EMAIL_THEME.mutedText }};">{{ 'app.mail.delivery.closingMessage'|trans }}</td></tr>
    <tr><td style="padding:0 32px 34px 32px; font-size:16px; line-height:1.5; color:{{ EMAIL_THEME.mutedText }};">{{ 'app.mail.delivery.closing'|trans }}<br>{{ 'app.mail.delivery.team'|trans }}</td></tr>
</table></td></tr></table></body>
</html>
