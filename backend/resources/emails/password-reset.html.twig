<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Passwort zurücksetzen</title>
</head>
<body style="margin:0; padding:0; background-color:#f4f7f5; font-family:Arial,Helvetica,sans-serif; color:#10213c;">
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%; background-color:#f4f7f5;">
    <tr>
      <td align="center" style="padding:24px 12px;">
        <table role="presentation" width="600" cellspacing="0" cellpadding="0" border="0" style="width:100%; max-width:600px; background-color:#ffffff; border:1px solid #b9e5c8; border-radius:20px;">
          <tr>
            <td style="padding:32px 32px 18px 32px; text-align:center;">
              <table role="presentation" cellspacing="0" cellpadding="0" border="0" align="center" style="margin:0 auto 22px auto;">
                <tr><td align="center"><img src="{{ LOGO_CID }}" width="210" alt="Gärngschee" style="display:block; width:210px; max-width:100%; height:auto;"></td></tr>
              </table>
              <h1 style="margin:0; font-size:28px; line-height:1.2; font-weight:700; color:#10213c;">Passwort zurücksetzen</h1>
            </td>
          </tr>
          <tr>
            <td style="padding:0 32px 8px 32px; text-align:center;">
              <p style="margin:0 0 14px 0; font-size:18px; line-height:1.5; color:#10213c;"><strong style="color:#0f6f36;">Wir helfen dir weiter.</strong></p>
              <p style="margin:0; font-size:17px; line-height:1.55; color:#4d5b6f;">Du hast angefordert, dein Passwort zurückzusetzen. Klicke auf den folgenden Button, um ein neues Passwort festzulegen.</p>
            </td>
          </tr>
          <tr>
            <td align="center" style="padding:24px 32px 18px 32px;">
              <table role="presentation" cellspacing="0" cellpadding="0" border="0"><tr><td align="center" bgcolor="#159447" style="border-radius:999px;"><a href="{{ RESET_URL }}" style="display:inline-block; padding:14px 26px; font-size:17px; line-height:1; font-weight:700; color:#ffffff; text-decoration:none; border-radius:999px;">Passwort zurücksetzen</a></td></tr></table>
            </td>
          </tr>
          <tr>
            <td style="padding:0 32px 34px 32px; text-align:center;">
              <p style="margin:0 0 8px 0; font-size:15px; line-height:1.5; color:#4d5b6f;">Der Link ist 10 Minuten gültig und kann nur einmal verwendet werden.</p>
              <p style="margin:0; font-size:15px; line-height:1.5; color:#4d5b6f;">Wenn du diese Anfrage nicht gestellt hast, kannst du diese E-Mail ignorieren.</p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
