<!doctype html>
<html lang="de">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Deine Mässpäggli-Bestellung ist definitiv bestätigt</title></head>
<body style="margin:0; padding:0; background-color:#f4f7f5; font-family:Arial,Helvetica,sans-serif; color:#10213c;"><table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%; background-color:#f4f7f5;"><tr><td align="center" style="padding:24px 12px;"><table role="presentation" width="600" cellspacing="0" cellpadding="0" border="0" style="width:100%; max-width:600px; background-color:#ffffff; border:1px solid #b9e5c8; border-radius:20px;">
  <tr><td style="padding:32px 32px 18px 32px; text-align:center;"><table role="presentation" cellspacing="0" cellpadding="0" border="0" align="center" style="margin:0 auto 22px auto;"><tr><td align="center"><img src="{{ LOGO_CID }}" width="210" alt="Gärngschee" style="display:block; width:210px; max-width:100%; height:auto;"></td></tr></table><h1 style="margin:0; font-size:28px; line-height:1.2; font-weight:700; color:#10213c;">Deine Mässpäggli-Bestellung ist definitiv bestätigt</h1></td></tr>
  <tr><td style="padding:0 32px 8px 32px; text-align:center;"><p style="margin:0 0 14px 0; font-size:18px; line-height:1.5; color:#10213c;"><strong style="color:#0f6f36;">Deine Bestellung ist definitiv bestätigt.</strong></p><p style="margin:0; font-size:17px; line-height:1.55; color:#4d5b6f;">Deine Bestellung für das Jahr {{ ORDER.year }} wurde definitiv bestätigt.</p></td></tr>
  <tr><td style="padding:24px 32px 8px 32px;"><table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%; background-color:#eefaf2; border:1px solid #c9e9d3; border-radius:14px;"><tr><td style="padding:18px;"><p style="margin:0 0 6px 0; font-size:16px; line-height:1.4; font-weight:700; color:#10213c;">Bereit zur Abholung</p><p style="margin:0; font-size:16px; line-height:1.5; color:#4d5b6f;">Sobald die Mässpäggli bereit sind, erhältst du eine E-Mail mit einem Barcode für die Abholung.</p></td></tr></table></td></tr>
  <tr><td style="padding:18px 32px 34px 32px;"><h2 style="margin:0 0 12px 0; font-size:21px; line-height:1.3; color:#10213c;">Bestellübersicht</h2><p style="margin:0 0 14px 0; font-size:16px; line-height:1.5; color:#4d5b6f;">Jahr: <strong>{{ ORDER.year }}</strong><br>Erwachsene: <strong>{{ ORDER.adultsCount }}</strong><br>Kinder: <strong>{{ ORDER.childrenCount }}</strong></p><table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%; border-collapse:collapse;">{% for item in ORDER.items %}<tr><td style="padding:9px 0; border-top:1px solid #e1e8e3; font-size:15px; line-height:1.4; color:#4d5b6f;">{{ item.personTypeLabel }} - {{ item.categoryLabel }}: {{ item.quantity }}</td></tr>{% endfor %}</table></td></tr>
</table></td></tr></table></body>
</html>
