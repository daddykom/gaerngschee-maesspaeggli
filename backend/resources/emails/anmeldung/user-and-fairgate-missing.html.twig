<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ 'anmeldung.user-and-fairgate-missing.title'|trans }}</title>
</head>
<body style="margin:0;padding:0;background:#f5f7fa;font-family:Arial,Helvetica,sans-serif;color:#14213d;">
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#f5f7fa;margin:0;padding:0;">
    <tr>
      <td align="center" style="padding:32px 12px;">
        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0"
               style="max-width:640px;background:#ffffff;border:1px solid #e4d3f4;border-radius:18px;">
          <tr>
            <td style="padding:34px 34px 18px 34px;">
              <div style="font-size:28px;line-height:1.25;font-weight:700;color:#14213d;">
                {{ 'anmeldung.user-and-fairgate-missing.title'|trans }}
              </div>
            </td>
          </tr>

          <tr>
            <td style="padding:0 34px 10px 34px;">
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                <tr>
                  <td width="92" valign="top" style="padding-right:18px;">
                    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="78" height="78"
                           style="width:78px;height:78px;background:#f1e8fb;border-radius:39px;">
                      <tr>
                        <td align="center" valign="middle" style="font-size:34px;line-height:78px;color:#7b3fb4;">
                          ✓
                        </td>
                      </tr>
                    </table>
                  </td>
                  <td valign="top" style="font-size:18px;line-height:1.55;color:#24324a;">
                    <p style="margin:0 0 12px 0;">
                      {{ 'anmeldung.user-and-fairgate-missing.body_one'|trans }}
                    </p>
                    <p style="margin:0;">
                      {{ 'anmeldung.user-and-fairgate-missing.body_two'|trans }}
                    </p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <tr>
            <td style="padding:18px 34px 8px 34px;">
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0"
                     style="background:#f7f1fc;border:1px solid #dfc8f1;border-radius:14px;">
                <tr>
                  <td style="padding:22px 24px;">
                    <div style="font-size:18px;line-height:1.4;font-weight:700;color:#7b3fb4;margin-bottom:8px;">
                      {{ 'anmeldung.user-and-fairgate-missing.next_title'|trans }}
                    </div>
                    <div style="font-size:17px;line-height:1.55;color:#24324a;">
                      {{ 'anmeldung.user-and-fairgate-missing.next_text'|trans }}
                    </div>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <tr>
            <td align="center" style="padding:20px 34px 34px 34px;">
              <table role="presentation" cellspacing="0" cellpadding="0" border="0">
                <tr>
                  <td align="center" bgcolor="#7b3fb4" style="border-radius:10px;">
                    <a href="{{FAIRGATE_URL}}"
                       style="display:inline-block;padding:14px 24px;font-size:17px;line-height:1.2;
                              font-weight:700;color:#ffffff;text-decoration:none;border-radius:10px;">
                      {{ 'anmeldung.user-and-fairgate-missing.button'|trans }}
                    </a>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
