{
  "name": "@frontend/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start": "nx serve",
    "build": "nx build",
    "test": "nx test",
    "test:ci": "nx test --configuration=ci",
    "e2e": "nx e2e",
    "e2e:ci": "nx e2e-ci",
    "lint": "nx lint --all",
    "test:all": "nx test && nx e2e",
    "db:start": "cd .. && docker-compose up -d",
    "db:stop": "cd .. && docker-compose down",
    "db:migrate": "cd .. && docker compose exec -T backend vendor/bin/phinx migrate -c /var/www/db/phinx.php",
    "db:seed": "cd .. && docker compose exec -T backend vendor/bin/phinx seed:run -e development -c /var/www/db/phinx.php",
    "db:setup": "npm run db:start && sleep 5 && npm run db:migrate && npm run db:seed",
    "db:reset": "npm run db:stop && npm run db:start && sleep 5 && npm run db:migrate && npm run db:seed",
    "composer": "cd .. && docker compose exec -T backend composer install --no-interaction",
    "composer:update": "cd .. && docker compose exec -T backend composer update --no-interaction"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.17",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "~21.2.0",
    "@angular/compiler": "~21.2.0",
    "@angular/core": "~21.2.0",
    "@angular/forms": "~21.2.0",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "~21.2.0",
    "@angular/platform-browser-dynamic": "~21.2.0",
    "@angular/router": "~21.2.0",
    "@angular/service-worker": "^21.2.17",
    "@ngrx/effects": "^21.1.1",
    "@ngrx/store": "^21.1.1",
    "@ngrx/store-devtools": "^21.1.1",
    "rxjs": "~7.8.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "~21.2.0",
    "@angular-devkit/schematics": "~21.2.0",
    "@angular/build": "~21.2.0",
    "@angular/cli": "~21.2.0",
    "@angular/compiler-cli": "~21.2.0",
    "@angular/language-service": "~21.2.0",
    "@angular/pwa": "^21.2.15",
    "@eslint/js": "^9.8.0",
    "@nx/angular": "22.7.5",
    "@nx/devkit": "22.7.5",
    "@nx/eslint": "22.7.5",
    "@nx/eslint-plugin": "22.7.5",
    "@nx/jest": "22.7.5",
    "@nx/js": "22.7.5",
